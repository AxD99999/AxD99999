+        camTransition = 1.0;
+      }
+    });
+
+    document.querySelectorAll('[data-cam]').forEach(btn => {
+      btn.addEventListener('click', () => setCameraPreset(btn.dataset.cam));
+    });
+    document.getElementById('btn-rotate').addEventListener('click', (e) => {
+      state.autoRotate = !state.autoRotate;
+      controls.autoRotate = state.autoRotate;
+      controls.autoRotateSpeed = 1.2;
+      e.currentTarget.classList.toggle('active', state.autoRotate);
+    });
+    document.getElementById('btn-theme').addEventListener('click', () => {
+      state.theme = state.theme === 'dark' ? 'light' : 'dark';
+      applyTheme();
+    });
+    document.querySelectorAll('.swatch').forEach(btn => {
+      btn.addEventListener('click', () => {
+        state.accent = btn.dataset.accent;
+        document.querySelectorAll('.swatch').forEach(b => b.classList.toggle('active', b === btn));
+        applyTheme();
+      });
+    });
+
+    window.addEventListener('keydown', (e) => {
+      if (e.key === '1') setCameraPreset('iso');
+      else if (e.key === '2') setCameraPreset('top');
+      else if (e.key === '3') setCameraPreset('front');
+      else if (e.key === '4') setCameraPreset('fly');
+      else if (e.key.toLowerCase() === 'r') setCameraPreset('iso');
+      else if (e.key.toLowerCase() === 't') { state.theme = state.theme === 'dark' ? 'light' : 'dark'; applyTheme(); }
+      else if (e.key === ' ') { document.getElementById('btn-rotate').click(); }
+    });
+
+    window.addEventListener('resize', () => {
+      camera.aspect = window.innerWidth / window.innerHeight;
+      camera.updateProjectionMatrix();
+      renderer.setSize(window.innerWidth, window.innerHeight);
+    });
+
+    const clock = new THREE.Clock();
+    function animate() {
+      requestAnimationFrame(animate);
+      const dt = Math.min(clock.getDelta(), 0.05);
+      const elapsed = clock.elapsedTime;
+
+      for (let i = 0; i < pillars.length; i++) {
+        const m = pillars[i];
+        const t = Math.max(0, Math.min(1, (elapsed - m.userData.delay) * 2.1));
+        if (t < 1 || Math.abs(m.scale.y - m.userData.targetH) > 0.002) {
+          const eased = 1 - Math.pow(1 - t, 3);
+          m.scale.y = Math.max(0.01, m.userData.targetH * eased);
+        }
+      }
+
+      if (state.mode === 'fly') {
+        state.flyTime += dt * 0.28;
+        const a = state.flyTime;
+        camera.position.lerp(new THREE.Vector3(Math.cos(a) * 34, 11 + Math.sin(a * 2) * 3.5, Math.sin(a) * 22), 0.04);
+        controls.target.lerp(new THREE.Vector3(Math.sin(a * 0.7) * 10, 2.2, 0), 0.05);
+      } else if (camTransition > 0.001) {
+        camera.position.lerp(camGoalPos, 0.08);
+        controls.target.lerp(camGoalTarget, 0.08);
+        if (camera.position.distanceTo(camGoalPos) < 0.08) camTransition = 0;
+      }
+
+      controls.update();
+
+      if (pointer.x > -2 && pillars.length) {
+        raycaster.setFromCamera(pointer, camera);
+        const hits = raycaster.intersectObjects(pillars, false);
+        setHover(hits.length ? hits[0].object : null);
+      }
+
+      renderer.render(scene, camera);
+    }
+
+    fetch('./data.json')
+      .then(r => (r.ok ? r.json() : Promise.reject(new Error('missing data.json'))))
+      .then(buildSkyline)
+      .catch(() => buildSkyline(makeFallbackData()));
+
+    animate();
+  </script>
+</body>
+</html>
