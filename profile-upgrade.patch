+            date
+            contributionCount
+            contributionLevel
+          }
+        }
+      }
+    }
+    repositories(first: 40, ownerAffiliations: OWNER, isFork: false, orderBy: {field: PUSHED_AT, direction: DESC}) {
+      nodes {
+        name
+        pushedAt
+        isPrivate
+        languages(first: 6, orderBy: {field: SIZE, direction: DESC}) {
+          edges {
+            size
+            node { name }
+          }
+        }
+        defaultBranchRef {
+          target {
+            ... on Commit {
+              history(first: 3) {
+                nodes {
+                  oid
