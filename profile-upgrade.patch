+        light: { accent: '#1a7f37', levels: [0xebedf0, 0x9be9a8, 0x40c463, 0x30a14e, 0x216e39] },
+      },
+      ice: {
+        dark:  { accent: '#58a6ff', levels: [0x161b22, 0x0d2b4e, 0x154c8a, 0x2b7de9, 0x79c0ff] },
+        light: { accent: '#0969da', levels: [0xebedf0, 0xb6e3ff, 0x54aeff, 0x0969da, 0x0550ae] },
+      },
+      amber: {
+        dark:  { accent: '#e3b341', levels: [0x161b22, 0x4a3109, 0x80530f, 0xc2811b, 0xf2cc60] },
+        light: { accent: '#9a6700', levels: [0xebedf0, 0xfce19c, 0xf0b429, 0xbf8700, 0x7d4e00] },
+      },
+    };
+
+    const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
+    const state = {
+      theme: window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark',
+      accent: 'emerald',
+      mode: 'iso',
+      autoRotate: false,
+      flyTime: 0,
+    };
+
+    const stage = document.getElementById('stage');
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 300);
+    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
+    renderer.setSize(window.innerWidth, window.innerHeight);
+    renderer.shadowMap.enabled = true;
+    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
+    renderer.toneMapping = THREE.ACESFilmicToneMapping;
+    renderer.toneMappingExposure = 1.06;
+    stage.appendChild(renderer.domElement);
+
+    const controls = new OrbitControls(camera, renderer.domElement);
+    controls.enableDamping = true;
+    controls.dampingFactor = 0.06;
+    controls.minDistance = 12;
+    controls.maxDistance = 110;
+    controls.maxPolarAngle = Math.PI / 2 - 0.04;
+
+    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x161b22, 0.9);
+    scene.add(hemiLight);
+
+    const keyLight = new THREE.DirectionalLight(0xffffff, 1.35);
+    keyLight.position.set(28, 46, 26);
+    keyLight.castShadow = true;
+    keyLight.shadow.mapSize.set(2048, 2048);
+    keyLight.shadow.camera.near = 10;
+    keyLight.shadow.camera.far = 120;
+    const sc = 36;
+    keyLight.shadow.camera.left = -sc;
+    keyLight.shadow.camera.right = sc;
+    keyLight.shadow.camera.top = sc;
+    keyLight.shadow.camera.bottom = -sc;
+    keyLight.shadow.bias = -0.0005;
+    scene.add(keyLight);
+
+    const rimLight = new THREE.DirectionalLight(0x58a6ff, 0.45);
+    rimLight.position.set(-30, 18, -22);
+    scene.add(rimLight);
+
+    const COLS = 52, ROWS = 7, STEP = 1.08;
+    const boardW = COLS * STEP + 2.2;
+    const boardD = ROWS * STEP + 2.2;
+    const baseMat = new THREE.MeshStandardMaterial({ roughness: 0.85, metalness: 0.1 });
+    const baseMesh = new THREE.Mesh(new THREE.BoxGeometry(boardW, 0.7, boardD), baseMat);
+    baseMesh.position.set(0, -0.35, 0);
+    baseMesh.receiveShadow = true;
+    scene.add(baseMesh);
+
+    const gridHelper = new THREE.GridHelper(120, 60, 0x30363d, 0x1b2028);
+    gridHelper.position.y = -0.71;
+    scene.add(gridHelper);
+
+    const camGoalPos = new THREE.Vector3();
+    const camGoalTarget = new THREE.Vector3();
+    let camTransition = 0;
+
+    function setCameraPreset(preset, instant = false) {
+      state.mode = preset;
+      document.querySelectorAll('[data-cam]').forEach(b => b.classList.toggle('active', b.dataset.cam === preset));
+      if (preset === 'fly') return;
+      if (preset === 'iso') {
+        camGoalPos.set(34, 27, 34);
+        camGoalTarget.set(0, 1.4, 0);
+      } else if (preset === 'top') {
+        camGoalPos.set(0, 56, 0.01);
+        camGoalTarget.set(0, 0, 0);
+      } else if (preset === 'front') {
+        camGoalPos.set(0, 11, 44);
+        camGoalTarget.set(0, 2.2, 0);
+      }
+      if (instant) {
+        camera.position.copy(camGoalPos);
+        controls.target.copy(camGoalTarget);
+        controls.update();
+      } else {
+        camTransition = 1.0;
+      }
+    }
+
+    const pillars = [];
+    const pillarGroup = new THREE.Group();
+    scene.add(pillarGroup);
+    const boxGeo = new THREE.BoxGeometry(0.84, 1, 0.84);
+    boxGeo.translate(0, 0.5, 0);
+
+    function makeFallbackData() {
+      const weeks = [];
+      for (let w = 0; w < 52; w++) {
+        const col = [];
+        for (let d = 0; d < 7; d++) {
+          const v = Math.sin(w * 0.27 + d * 0.55) * 0.5 + Math.cos(w * 0.13 - d * 0.9) * 0.35;
+          const count = v < 0.05 ? 0 : Math.max(1, Math.round((v + 0.3) ** 2 * 5));
+          const level = count === 0 ? 0 : count <= 2 ? 1 : count <= 5 ? 2 : count <= 9 ? 3 : 4;
+          col.push({ date: `Week ${w + 1}`, count, level });
+        }
+        weeks.push(col);
+      }
+      return {
+        username: 'AxD99999',
+        stats: { total: 1120, peakWeek: 42, streak: 14, peakDay: 14 },
+        weeks,
+      };
+    }
+
+    function buildSkyline(data) {
+      document.getElementById('repo-title').textContent = `${data.username} / skyline-3d`;
+      document.getElementById('stats-row').innerHTML =
+        `<span><strong>${data.stats.total.toLocaleString()}</strong> commits</span>` +
+        `<span><strong>${data.stats.peakWeek}/wk</strong> peak</span>` +
+        `<span><strong>${data.stats.streak}d</strong> streak</span>`;
+
+      const maxDay = Math.max(data.stats.peakDay || 1, 1);
+      const startX = -((COLS - 1) * STEP) / 2;
+      const startZ = -((ROWS - 1) * STEP) / 2;
+
+      data.weeks.forEach((col, w) => {
+        col.forEach((day, d) => {
+          const cnt = day.count || 0;
+          const lvl = Math.max(0, Math.min(4, day.level || 0));
+          const targetH = cnt === 0 ? 0.16 : 0.45 + Math.sqrt(cnt / maxDay) * 8.6;
+
+          const mat = new THREE.MeshStandardMaterial({
+            roughness: lvl === 0 ? 0.85 : 0.38,
+            metalness: lvl === 0 ? 0.05 : 0.14,
+          });
+          const mesh = new THREE.Mesh(boxGeo, mat);
+          mesh.position.set(startX + w * STEP, 0, startZ + d * STEP);
+          mesh.scale.set(1, 0.01, 1);
+          mesh.castShadow = cnt > 0;
+          mesh.receiveShadow = true;
+          mesh.userData = {
+            w, d, count: cnt, level: lvl, date: day.date,
+            targetH, delay: w * 0.014 + d * 0.018,
+          };
+          pillarGroup.add(mesh);
+          pillars.push(mesh);
+        });
+      });
+
+      applyTheme();
+      setCameraPreset('iso', true);
+    }
+
+    function applyTheme() {
+      const dark = state.theme === 'dark';
+      document.documentElement.dataset.theme = state.theme;
+      const pal = PALETTES[state.accent][state.theme];
+      document.documentElement.style.setProperty('--accent', pal.accent);
+      document.getElementById('btn-theme').textContent = dark ? 'Light' : 'Dark';
+
+      const bgHex = dark ? 0x0d1117 : 0xf6f8fa;
+      scene.background = new THREE.Color(bgHex);
+      scene.fog = new THREE.FogExp2(bgHex, dark ? 0.0085 : 0.007);
+
+      baseMat.color.setHex(dark ? 0x161b22 : 0xeaeef2);
+      hemiLight.color.setHex(dark ? 0xdbe9ff : 0xffffff);
+      hemiLight.groundColor.setHex(dark ? 0x0d1117 : 0xcbd5e1);
+      hemiLight.intensity = dark ? 0.9 : 1.15;
+      keyLight.intensity = dark ? 1.35 : 1.15;
+      rimLight.color.set(pal.accent);
+      rimLight.intensity = dark ? 0.55 : 0.25;
+
+      gridHelper.material.color.setHex(dark ? 0x21262d : 0xd8dee4);
+      gridHelper.material.opacity = dark ? 0.55 : 0.7;
+      gridHelper.material.transparent = true;
+
+      pillars.forEach(mesh => {
+        const lvl = mesh.userData.level;
+        mesh.material.color.setHex(pal.levels[lvl]);
+        mesh.material.emissive.setHex(lvl === 4 ? pal.levels[4] : 0x000000);
+        mesh.material.emissiveIntensity = lvl === 4 ? (dark ? 0.18 : 0.05) : 0;
+      });
+    }
+
+    const raycaster = new THREE.Raycaster();
+    const pointer = new THREE.Vector2(-99, -99);
+    const tooltip = document.getElementById('tooltip');
+    const ttDate = document.getElementById('tt-date');
+    const ttCount = document.getElementById('tt-count');
+    let hovered = null;
+    let downPos = { x: 0, y: 0 };
+
+    function setHover(mesh) {
+      if (hovered === mesh) return;
+      if (hovered) {
+        const pal = PALETTES[state.accent][state.theme];
+        const lvl = hovered.userData.level;
+        hovered.material.emissive.setHex(lvl === 4 ? pal.levels[4] : 0x000000);
+        hovered.material.emissiveIntensity = lvl === 4 ? (state.theme === 'dark' ? 0.18 : 0.05) : 0;
+      }
+      hovered = mesh;
+      if (hovered) {
+        const pal = PALETTES[state.accent][state.theme];
+        hovered.material.emissive.set(pal.accent);
+        hovered.material.emissiveIntensity = 0.45;
+        const { date, d, count } = hovered.userData;
+        ttDate.textContent = `${date || 'Contribution'} · ${WEEKDAYS[d]}`;
+        ttCount.innerHTML = `<span>${count}</span> contribution${count === 1 ? '' : 's'}`;
+        tooltip.classList.add('show');
+      } else {
+        tooltip.classList.remove('show');
+      }
+    }
+
+    stage.addEventListener('pointermove', (e) => {
+      pointer.x = (e.clientX / window.innerWidth) * 2 - 1;
+      pointer.y = -(e.clientY / window.innerHeight) * 2 + 1;
+      tooltip.style.left = `${e.clientX}px`;
+      tooltip.style.top = `${e.clientY}px`;
+    });
+    stage.addEventListener('pointerleave', () => {
