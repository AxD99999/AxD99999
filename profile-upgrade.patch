+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>AxD99999 — Interactive 3D Contribution Skyline</title>
+  <style>
+    :root {
+      --bg: #0d1117;
+      --panel: rgba(22, 27, 34, 0.82);
+      --border: #30363d;
+      --fg: #e6edf3;
+      --muted: #8b949e;
+      --accent: #3fb950;
+      --accent-soft: rgba(63, 185, 80, 0.16);
+      --font: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+    }
+    [data-theme="light"] {
+      --bg: #f6f8fa;
+      --panel: rgba(255, 255, 255, 0.86);
+      --border: #d0d7de;
+      --fg: #1f2328;
+      --muted: #656d76;
+      --accent-soft: rgba(26, 127, 55, 0.12);
+    }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    html, body {
+      width: 100%;
+      height: 100%;
+      overflow: hidden;
+      background: var(--bg);
+      color: var(--fg);
+      font-family: var(--font);
+      -webkit-font-smoothing: antialiased;
+    }
+    #stage {
+      position: fixed;
+      inset: 0;
+      cursor: grab;
+    }
+    #stage:active { cursor: grabbing; }
+
+    .hud {
+      position: fixed;
+      z-index: 10;
+      backdrop-filter: blur(12px);
+      -webkit-backdrop-filter: blur(12px);
+      background: var(--panel);
+      border: 1px solid var(--border);
+      border-radius: 10px;
+      padding: 12px 15px;
+      font-size: 12px;
+      line-height: 1.5;
+      user-select: none;
+    }
+    .hud-tl {
+      top: 16px;
+      left: 16px;
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      max-width: min(360px, calc(100vw - 32px));
+    }
+    .title-row {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      font-size: 13px;
+      font-weight: 700;
+    }
+    .dot {
+      width: 8px;
+      height: 8px;
+      border-radius: 50%;
+      background: var(--accent);
+      box-shadow: 0 0 8px var(--accent);
+      flex-shrink: 0;
+    }
+    .back-link {
+      color: var(--muted);
+      text-decoration: none;
+      font-weight: 500;
+      margin-left: auto;
+      font-size: 11px;
+      border: 1px solid var(--border);
+      padding: 2px 8px;
+      border-radius: 999px;
+      transition: color 0.15s, border-color 0.15s;
+    }
+    .back-link:hover { color: var(--fg); border-color: var(--accent); }
+    .stats-row {
+      display: flex;
+      flex-wrap: wrap;
